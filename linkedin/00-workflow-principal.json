        "jsCode": "const unwrap = (v) => Array.isArray(v) ? v[0] : v;\nconst allInputs = $input.all();\nconst topics = [];\nlet counter = 0;\n\nfor (const input of allInputs) {\n  const rss = unwrap(input.json.rss);\n  const channel = unwrap(rss.channel);\n  const fonte = unwrap(channel.title) || 'Economia';\n  let items = channel.item || [];\n  if (!Array.isArray(items)) items = [items];\n\n  items.slice(0, 10).forEach(it => {\n    const title = unwrap(it.title) || '';\n    const link = unwrap(it.link) || '';\n\n    if (!title || !link) return;\n\n    topics.push({\n      json: {\n        topicId: 'economia_' + counter++,\n        topic: title,\n        traffic: '',\n        articles: [\n          { title: title, url: link, source: fonte }\n        ]\n      }\n    });\n  });\n}\n\nreturn topics;"
      },
