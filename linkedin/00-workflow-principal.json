    {
      "parameters": {
        "jsCode": "function normalizarTopico(texto) {\n  let s = String(texto || '')\n    .normalize('NFD')\n    .replace(/[\\u0300-\\u036f]/g, '')\n    .toLowerCase()\n    .replace(/[^\\p{L}\\p{N}\\s]/gu, ' ')\n    .replace(/\\s+/g, ' ')\n    .trim();\n  s = s.replace(/^(o|a|os|as|um|uma|uns|umas)\\s+/i, '');\n  return s;\n}\n\nconst items = $input.all();\n\nconst DIAS_HISTORICO = 5;\nconst hoje = new Date();\nconst limite = new Date(hoje.getTime() - DIAS_HISTORICO * 24 * 60 * 60 * 1000);\n\nconst historico = $('00. Apurador - Buscar Historico Recente').all();\nconst topicosHistoricos = new Set();\n\nfor (const h of historico) {\n  const dataStr = h.json.data;\n  const dataItem = dataStr ? new Date(dataStr) : null;\n  if (dataItem && dataItem >= limite) {\n    const chave = normalizarTopico(h.json.topico);\n    if (chave) topicosHistoricos.add(chave);\n  }\n}\n\nconst aprovados = items.filter(item => Number(item.json.nota) >= 70);\n\naprovados.sort((a, b) => (Number(b.json.nota) || 0) - (Number(a.json.nota) || 0));\n\nconst vistos = new Set();\nconst unicos = [];\n\nfor (const item of aprovados) {\n  const chave = normalizarTopico(item.json.topic);\n\n  if (!chave || vistos.has(chave) || topicosHistoricos.has(chave)) {\n    continue;\n  }\n\n  vistos.add(chave);\n  unicos.push({ json: { ...item.json } });\n}\n\nreturn unicos.slice(0, 3);"
      },
