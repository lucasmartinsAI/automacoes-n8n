      "id": "9586d1df-7b55-4c3e-b3ac-ad8a0dc1490f",
      "name": "02. Apurador - Juntar Textos"
    },
    {
      "parameters": {
        "jsCode": "const groups = {};\nfor (const item of $input.all()) {\n  const d = item.json;\n  if (!groups[d.topicId]) {\n    groups[d.topicId] = { topicId: d.topicId, topic: d.topic, traffic: d.traffic, articles: [] };\n  }\n  if (d.articleText && d.articleText.length > 100) {\n    groups[d.topicId].articles.push({ title: d.title, source: d.source, url: d.url, text: d.articleText });\n  }\n}\nreturn Object.values(groups)\n  .filter(g => g.articles.length > 0)\n  .map(g => ({ json: g }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2464,
        0
      ],
      "id": "4b5047a0-fdfc-40e2-a270-1982a8691262",
      "name": "02. Apurador - Reagrupar por Topico"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const now = new Date();\nlet status = 'pendente';\nif ($json.compliance_status === 'bloqueado') status = 'bloqueado_compliance';\nelse if ($json.fact_check_status === 'divergencia') status = 'bloqueado_factcheck';\nelse if ($json.originalidade_alerta) status = 'alerta_originalidade';\n\nconst currentTopic = $json.topic;\nconst curadoriaItems = $('Redação (sub-workflow)').all();\nconst curadoriaMatch = curadoriaItems.find(item => item.json.topic === currentTopic);\nconst especialidadeEditoria = curadoriaMatch ? curadoriaMatch.json.especialidade_editoria : '';\nconst articles = curadoriaMatch ? (curadoriaMatch.json.articles || []) : [];\nconst fontes = articles.map(a => `${a.source} (${a.url})`).join('; ');\n\nreturn {\n  json: {\n    data: now.toISOString().slice(0, 10),\n    topico: $json.topic,\n    fontes: fontes,\n    post_final: $json.post_final,\n    hashtags: $json.hashtags,\n    status: status,\n    checklist: $json.checklist,\n    ajustes_feitos: $json.ajustes_feitos,\n    especialidade_editoria: especialidadeEditoria,\n    fact_check_status: $json.fact_check_status,\n    compliance_status: $json.compliance_status,\n    originalidade_score: $json.originalidade_score,\n    tem_cta: $json.cta_tipo,\n    imagem_url: $json.imagem_url || '',\n    horario_postado: '',\n    curtidas: '',\n    comentarios: '',\n    compartilhamentos: '',\n    cliente_sintetico_score: ''\n  }\n};"
      },
