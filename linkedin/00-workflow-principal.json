      "name": "02. Apurador - Buscar Artigo",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const origin = $('02. Apurador - Achatar Artigos').item.json;\nconst body = $json.data || '';\nconst statusCode = $json.statusCode;\nconst hasError = !!$json.error;\nconst stripped = String(body).replace(/<[^>]+>/g, ' ');\nconst tooShort = stripped.trim().length < 300;\nconst blockedHint = /enable javascript|access denied|403 forbidden|attention required|checking your browser|just a moment/i.test(body);\nconst needsJina = hasError || tooShort || blockedHint || (statusCode && statusCode >= 400);\n\nreturn {\n  json: {\n    topicId: origin.topicId,\n    topic: origin.topic,\n    traffic: origin.traffic,\n    url: origin.url,\n    title: origin.title,\n    source: origin.source,\n    rawHtml: body,\n    needsJinaFlag: needsJina ? 'sim' : 'nao'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        0
      ],
