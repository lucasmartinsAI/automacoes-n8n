    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const clean = String($json.rawHtml || '')\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, ' ')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, ' ')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 6000);\n\nreturn {\n  json: {\n    topicId: $json.topicId,\n    topic: $json.topic,\n    traffic: $json.traffic,\n    url: $json.url,\n    title: $json.title,\n    source: $json.source,\n    articleText: clean\n  }\n};"
      },
