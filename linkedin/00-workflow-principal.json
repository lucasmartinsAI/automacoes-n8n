      "id": "214f2418-c056-407d-b429-fdab77ed58a4",
      "name": "01. Pesquisador de Tendencias - Converter XML"
    },
    {
      "parameters": {
        "jsCode": "const unwrap = (v) => Array.isArray(v) ? v[0] : v;\n\nconst input = $input.first().json;\nconst rss = unwrap(input.rss);\nconst channel = unwrap(rss.channel);\nlet items = channel.item || [];\nif (!Array.isArray(items)) items = [items];\n\nconst topics = items.slice(0, 10).map((it, idx) => {\n  const topicTitle = unwrap(it.title);\n  const traffic = unwrap(it['ht:approx_traffic']);\n  let newsItems = it['ht:news_item'] || [];\n  if (!Array.isArray(newsItems)) newsItems = [newsItems];\n\n  const articles = newsItems.slice(0, 3).map(n => ({\n    title: unwrap(n['ht:news_item_title']) || '',\n    url: unwrap(n['ht:news_item_url']) || '',\n    source: unwrap(n['ht:news_item_source']) || ''\n  })).filter(a => a.url);\n\n  return {\n    json: {\n      topicId: 'topic_' + idx,\n      topic: topicTitle,\n      traffic: traffic || '',\n      articles\n    }\n  };\n});\n\nreturn topics;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        -48
      ],
      "id": "1197569d-d941-4d77-8d4d-051c97a1ebf9",
      "name": "01. Pesquisador de Tendencias - Extrair Topicos"
    },
    {
      "parameters": {
        "jsCode": "const output = [];\nfor (const item of $input.all()) {\n  const t = item.json;\n  (t.articles || []).forEach((a, i) => {\n    output.push({\n      json: {\n        topicId: t.topicId,\n        topic: t.topic,\n        traffic: t.traffic,\n        articleIndex: i,\n        title: a.title,\n        url: a.url,\n        source: a.source\n      }\n    });\n  });\n}\nreturn output;"
      },
