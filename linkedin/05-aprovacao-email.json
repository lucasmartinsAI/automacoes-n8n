      "parameters": {
        "jsCode": "const items = $input.all();\nconst candidatos = items.filter(item => {\n  const j = item.json;\n  const temPost = j.post_final && String(j.post_final).trim() !== '';\n  const pendente = j.status === 'pendente';\n  const semDecisao = !j.aprovado_editor || String(j.aprovado_editor).trim() === '';\n  const naoPostado = !j.horario_postado || String(j.horario_postado).trim() === '';\n  return temPost && pendente && semDecisao && naoPostado;\n});\n\nif (candidatos.length === 0) {\n  throw new Error('Nenhum rascunho pronto e aguardando aprovação encontrado na planilha.');\n}\n\nreturn [candidatos[0]];"
      },
