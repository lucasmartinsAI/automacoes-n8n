    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst nomeApi = $('[GUARDA][N01] - Trigger Sub-workflow').item.json.nomeApi;\nconst limiteDiario = $('[GUARDA][N01] - Trigger Sub-workflow').item.json.limiteDiario;\nconst hoje = new Date().toISOString().slice(0, 10);\n\nlet contadores = {};\nif (item.data) {\n  try { contadores = JSON.parse(item.data); } catch (e) { contadores = {}; }\n}\n\nif (!contadores[nomeApi] || contadores[nomeApi].data !== hoje) {\n  contadores[nomeApi] = { data: hoje, contagem: 0 };\n}\n\nlet permitido = false;\nif (contadores[nomeApi].contagem < limiteDiario) {\n  contadores[nomeApi].contagem += 1;\n  permitido = true;\n}\n\nreturn [{\n  json: {\n    permitido: permitido,\n    contagemAtual: contadores[nomeApi].contagem,\n    limiteDiario: limiteDiario,\n    nomeApi: nomeApi,\n    contadoresJson: JSON.stringify(contadores, null, 2)\n  }\n}];"
      },
